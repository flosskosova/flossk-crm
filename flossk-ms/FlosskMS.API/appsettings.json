{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Certificates": {
    "BaseUrl": "https://root.flossk.org"
  },
  "EncryptionSettings": {
    "StorePath": "/etc/flossk/secrets/encryption.store",
    "MasterKeyEnvVar": "FLOSSK_ENCRYPTION_MASTER_KEY"
  }
}
